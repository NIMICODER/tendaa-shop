# Build output
bin/
obj/
out/
publish/
artifacts/

# IDEs
.vs/
.vscode/*
!.vscode/extensions.json
.idea/
*.user
*.suo
*.rsuser

# Test results
TestResults/
coverage/
*.trx

# Serilog file sink output
logs/

# Secrets and local config (secrets belong in dotnet user-secrets, never in the repo)
.env
.env.*
!.env.example
appsettings.*.local.json
secrets.json

# Local media saved during development (may contain receipts and voice notes) — matches the
# distinctively-named "media-storage" folder wherever `dotnet run`'s working directory puts it
# (src/Tendaa.Web/media-storage/ in practice), without the earlier bare "media/"/"uploads/"
# pattern that also silently matched real source directories (src/Tendaa.Agent/Media,
# tests/Tendaa.Agent.Tests/Media) and excluded them from every commit.
media-storage/

# Frontend (web/) build output and caches
node_modules/
web/dist/
web/.vite/
*.tsbuildinfo
src/Tendaa.Web/wwwroot/

# OS
.DS_Store
Thumbs.db
